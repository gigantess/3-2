# Gemini API Key (Gemini 모델 연동용)
GEMINI_API_KEY=your-gemini-api-key-here

# Firebase Firestore Service Account Key (JSON 파일 경로 또는 JSON 문자열)
# 예: firebase-credentials.json 또는 {"type": "service_account", ...}
FIREBASE_SERVICE_ACCOUNT_JSON=firebase-credentials.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# CORS 설정 (프론트엔드 배포 도메인, 콤마로 구분)
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000,https://your-vercel-app.vercel.app

# 로컬 개발 포트 및 호스트
PORT=8000
HOST=0.0.0.0

# 로컬 테스트용 Mock DB 강제 여부 (true/false)
USE_MOCK_DB=false

# Discord Webhook 연동 URL (AI 채팅 및 주가 브리핑 전송용)
DISCORD_WEBHOOK_URL=your-discord-webhook-url-here
